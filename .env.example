# SatQuery AI — Environment Configuration Example

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
SATQUERY_ENV=development

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# VQA LoRA Adapter Path (Set to use custom project-owned LoRA weights)
VQA_ADAPTER_DIR=training/checkpoints/satquery_vqa_lora

# Change Detection Calibrated Default Threshold (Derived from LEVIR-CD Sweep)
DEFAULT_CHANGE_THRESHOLD=0.30

# HuggingFace Token (Optional: for higher rate limits)
# HF_TOKEN=hf_your_token_here
